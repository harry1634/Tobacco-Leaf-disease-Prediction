# Dependencies / builds
node_modules/
.next/
out/
.vercel/

# Secrets - never commit
.env
.env.*
!.env.example
*serviceAccount*.json
*service-account*.json
*firebase-adminsdk*.json
kaggle.json

# Python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# ML data and heavy artifacts (dataset stays local / in Colab)
ml/data/*
!ml/data/.gitkeep
ml/outputs/*
!ml/outputs/.gitkeep
!ml/outputs/**/*.json
# keep the small metrics files of finished runs (never the model weights, which *.pt excludes)
!ml/outputs/*-full-s*/
!ml/outputs/centralised*/
*.pt
*.pth

# Firebase local
.firebase/
firebase-debug.log
*.log

# OS / editor
.DS_Store
Thumbs.db

# Colab upload bundle
*.zip

